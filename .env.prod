# 生產環境配置文件
# 資料庫配置
POSTGRES_DB=health_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

MONGODB_USER=admin
MONGODB_PASSWORD=your_secure_mongodb_password_here
MONGODB_DB=health_tracker_nutrition

REDIS_PASSWORD=your_secure_redis_password_here

# API 配置
JWT_SECRET=your_very_secure_jwt_secret_key_here_at_least_32_characters
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# AWS 配置
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-west-2

# 監控配置
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# 備份配置
S3_BACKUP_BUCKET=health-nutrition-backups

# 前端配置
NEXT_PUBLIC_API_URL=http://localhost

# 注意：這是範例配置，請在實際部署前更改所有密碼和金鑰