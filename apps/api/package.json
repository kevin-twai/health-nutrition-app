{
  "name": "@health-tracker/api",
  "version": "1.0.0",
  "description": "健康營養追蹤系統後端 API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --testPathPattern=e2e --runInBand --detectOpenHandles",
    "test:performance": "jest --testPathPattern=performance --runInBand --detectOpenHandles",
    "test:security": "jest --testPathPattern=security --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "db:migrate:test": "node scripts/test-db-setup.js",
    "db:seed:test": "node scripts/test-db-setup.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "@health-tracker/shared-types": "*",
    "@notionhq/client": "^5.3.0",
    "@types/uuid": "^10.0.0",
    "aws-sdk": "^2.1419.0",
    "axios": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^2.1.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.8.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "mongodb": "^5.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.1",
    "redis": "^4.6.7",
    "sharp": "^0.34.4",
    "uuid": "^8.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.3",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^2.0.12",
    "@types/winston": "^2.4.4",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^3.12.7",
    "typescript": "^5.1.0"
  }
}
