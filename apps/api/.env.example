# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health_nutrition_tracker
DB_USER=postgres
DB_PASSWORD=password

MONGODB_URI=mongodb://localhost:27017/health_tracker_nutrition

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Password Encryption
BCRYPT_ROUNDS=12

# External APIs
OPENAI_API_KEY=your-openai-api-key
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2
AWS_S3_BUCKET=health-tracker-images

# Third-party Integrations
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret

LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret# OAu
th Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# Email Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@health-tracker.com
FROM_NAME=健康營養追蹤系統

# API Gateway Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://health-tracker.local

# Rate Limiting Configuration
AUTH_RATE_LIMIT=5
PHOTO_RATE_LIMIT=10
GENERAL_RATE_LIMIT=1000

# Security Configuration
VALID_API_KEYS=api-key-1,api-key-2
IP_WHITELIST=127.0.0.1,::1
MAX_REQUEST_SIZE=10MB

# Monitoring Configuration
METRICS_RETENTION=10000
ERROR_RATE_THRESHOLD=10
RESPONSE_TIME_THRESHOLD=2000
MEMORY_USAGE_THRESHOLD=80

# Load Balancer Configuration
HEALTH_CHECK_INTERVAL=30000
MAX_RETRIES=3
RETRY_DELAY=1000

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs

# AWS CloudWatch Configuration
AWS_CLOUDWATCH_ENABLED=true
AWS_SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-northeast-1:123456789012:health-tracker-alerts

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
SLOW_OPERATION_THRESHOLD=1000
PERFORMANCE_METRICS_RETENTION=3600000

# Alert Configuration
ALERT_EMAIL_ENABLED=true
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_NOTIFICATION_COOLDOWN=300000

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
EXTERNAL_API_HEALTH_CHECK=true

# Monitoring Dashboard
MONITORING_DASHBOARD_ENABLED=true
METRICS_EXPORT_INTERVAL=60000