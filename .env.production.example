# 生產環境配置範本
# 複製此檔案為 .env.production 並填入真實值

# 應用程式環境
NODE_ENV=production
PORT=3001

# JWT 秘密 (請使用強密碼)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# OpenAI API 配置 (必填)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Vision API 配置 (可選，用於圖片識別)
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# 資料庫配置 (如使用外部資料庫)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=health_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# MongoDB 配置 (可選)
MONGODB_URI=mongodb://localhost:27017/health_tracker_nutrition

# Redis 配置 (可選)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# AWS 配置 (可選，用於檔案儲存)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2
S3_BACKUP_BUCKET=health-nutrition-backups

# 應用程式 URL
NEXT_PUBLIC_API_URL=https://your-domain.com

# 第三方整合 (可選)
NOTION_API_KEY=secret_your-notion-api-key
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-access-token

# 監控配置 (可選)
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=your-grafana-password